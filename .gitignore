# Ignore sensitive environment files
# NEVER commit your .env file. Instead, commit a template like .env.example
.env
*.env.local

# Ignore Python dependencies and caches
/backend/venv/
/backend/__pycache__/
*.pyc

# Ignore Node.js dependencies and build artifacts
/frontend/node_modules/
/frontend/.next/
/frontend/build/
/frontend/dist/
/frontend/npm-debug.log*
/frontend/yarn-error.log*

# Ignore macOS and IDE files
.DS_Store
.vscode/
.idea/